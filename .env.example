# Used by the db container to create the database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=docs_assistant

# Host "db" is the compose service name. Keep the credentials in sync with the values above.
DATABASE_URL=postgresql+psycopg://postgres:change_me@db:5432/docs_assistant

GROQ_API_KEY=your_groq_key
WEBHOOK_SECRET=WEBHOOK_SECRET
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
